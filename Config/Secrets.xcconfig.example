// Copy this file to Config/Secrets.xcconfig and fill in what you have.
// Secrets.xcconfig is gitignored; never commit a key (the Sous repo is public).
// The values land in the built Info.plist, which the services read with Bundle.main.
//
// xcconfig gotcha: "//" starts a comment, so write URLs as https:/$()/host/path.

// Supadata (YouTube transcript API) — https://supadata.ai
SUPADATA_API_KEY = sd_xxxxxxxxxxxxxxxxxxxxxxxx

// OpenAI — recipe/slideshow generation from the transcript
OPENAI_API_KEY = sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL = gpt-5-mini

// OpenAI images — one picture per step (Services/Images reads these three)
IMAGE_API_URL = https:/$()/api.openai.com/v1/images/generations
IMAGE_API_KEY = sk-xxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_API_MODEL = gpt-image-1

// Alternatives already supported by Services/Recipe and Services/Images
// ANTHROPIC_API_KEY = sk-ant-xxxxxxxx
// GEMINI_API_KEY = AIzaxxxxxxxx
// GEMINI_MODEL = gemini-2.5-flash
// GEMINI_IMAGE_MODEL = gemini-2.5-flash-image
